# Nash OSS — Environment Configuration
# Copy this file to .env and fill in the secrets below.
# Everything else has sensible defaults for `make dev`.
#
# Sign-in needs no configuration at all: users paste their Backboard API
# key (from https://app.backboard.io/settings) on the login page.

# ============================================================
# REQUIRED
#   ENCRYPTION_KEY:    openssl rand -hex 16
#   FLASK_SECRET_KEY:  openssl rand -hex 32   (auto-generated on boot if
#                                              blank; set explicitly for
#                                              multi-replica deploys)
# ============================================================
ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_16
FLASK_SECRET_KEY=

# ============================================================
# Server
# DOMAIN_SERVER  = where Flask listens (keep at :3080 for `make dev`).
# DOMAIN_CLIENT  = where the browser lives. For `make dev` that's
#                  the Vite dev server on :3090. For docker-compose
#                  (single container serving the built SPA) set both
#                  to http://localhost:3080.
# ============================================================
HOST=0.0.0.0
PORT=3080
DOMAIN_CLIENT=http://localhost:3090
DOMAIN_SERVER=http://localhost:3080

# ============================================================
# Backboard API (defaults to the hosted service)
# ============================================================
BACKBOARD_API_URL=https://app.backboard.io/api

# ============================================================
# DynamoDB (sessions + user state)
# Local dev: `make dev` brings up DynamoDB Local in Docker on :8100.
# Production: drop DYNAMO_ENDPOINT and use IAM roles.
# ============================================================
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMO_ENDPOINT=http://localhost:8100
DYNAMO_TABLE=nash
DYNAMO_STATE_TABLE=nash_state
DYNAMO_REGION=us-east-1

# ============================================================
# Session TTL (days). Sliding — bumped on each authenticated request.
# ============================================================
SESSION_TTL_DAYS=30

# ============================================================
# OPTIONAL: Google Workspace MCP catalog (Gmail/Calendar/Drive tools).
# Not used for sign-in. Leave blank to hide the Workspace catalog.
# See docs/mcp-google-workspace-setup.md.
# ============================================================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ============================================================
# Local dev convenience: allows the placeholder ENCRYPTION_KEY.
# Never set outside local development.
# ============================================================
NASH_ENV=development
